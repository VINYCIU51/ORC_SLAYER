[gd_scene load_steps=2 format=3 uid="uid://d1gfpyvfxrtjw"]

[sub_resource type="GDScript" id="GDScript_4fofe"]
script/source = "extends Node

@export var mob : Enemy

var distance

func _ready() -> void:
	mob.has_spawned = false
	
func _physics_process(delta: float) -> void:
	# Calculos de posicao
	distance = Mobs.distance_to(mob, mob.player)

	if distance <= mob.dist_spawn and !mob.has_spawned:
		mob.is_spawning = true
"

[node name="TypeSpawn" type="Node2D"]
script = SubResource("GDScript_4fofe")
