[sub_resource type="GDScript" id="GDScript_7j4bw"]
script/source = "extends Node2D

@onready var animation: AnimationPlayer = $layer/animation
@onready var layer: CanvasLayer = $layer

func start():
	animation.play(\"start_load\")
	await animation.animation_finished
	
func end():
	animation.play(\"end_load\")
	await animation.animation_finished
"

