[gd_scene load_steps=6 format=3 uid="uid://ybu2vp4d5wt7"]

[sub_resource type="GDScript" id="GDScript_3rf4r"]
script/source = "extends CanvasLayer

@onready var menu: Control = $menu
@onready var animation: AnimationPlayer = $menu/animation
var map

# Exibe o menu
func show_menu(player : Player):
	map = Utils.get_main_scene(player)
	visible = true
	animation.play(\"show\")
	
	PauseMenu.pause_enabled = false
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)

# verificacoes de click
func _on_try_again_pressed() -> void:
	close_menu()
	Transition.to(map.name)

func _on_back_menu_pressed() -> void:
	close_menu()
	Transition.to(\"menu\")

# Funçao para fazer todos os controles ao fechar o menu
func close_menu():
	Input.set_mouse_mode(Input.MOUSE_MODE_CONFINED_HIDDEN)
	PauseMenu.pause_enabled = true
	visible = false
	animation.play(\"hide\")
	await animation.animation_finished
"

